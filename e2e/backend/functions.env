# Environment of the edge functions served to the browser tests
# (`supabase functions serve --env-file e2e/backend/functions.env`).
# Every value is a dummy. With these, a function that reaches Stripe, Resend
# or OpenAI is refused by the provider: nothing can be charged, sent or
# generated. SUPABASE_URL and the Supabase keys are injected by the CLI.
STRIPE_SECRET_KEY=sk_test_e2e_dummy_not_a_real_key
STRIPE_WEBHOOK_SECRET=whsec_e2e_dummy_not_a_real_secret
STRIPE_PRICE_ID_PREMIUM=price_e2e_dummy
RESEND_API_KEY=re_e2e_dummy_not_a_real_key
OPENAI_API_KEY=sk-e2e-dummy-not-a-real-key
LOVABLE_API_KEY=e2e-dummy-not-a-real-key
APP_URL=http://127.0.0.1:4173
